# --- Site ---
# URL canonique du site, sans slash final (ex. https://www.tendancemarrakech.com)
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connexion Postgres directe (pooler Supabase recommandé pour drizzle-kit)
DATABASE_URL=

# --- Conversion ---
# Numéro WhatsApp au format international sans "+" (ex. 212600000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Destinataire des notifications de leads
ADMIN_EMAIL=

# --- Feature flags ---
# Phase 1 : false. Passer à true ouvrira la publication aux tiers (Phase 2).
NEXT_PUBLIC_MARKETPLACE_MODE=false

# --- Optionnel ---
NEXT_PUBLIC_GA4_ID=
RESEND_API_KEY=
